<%- include ("../admin/layout/header") %>   
<%- include("../admin/layout/sidebar")%>
<%- include("../admin/layout/navbar") %>   

<link rel="stylesheet" href="/css/addDoctor.css">

<div class="container-fluid form-page">

<div class="row justify-content-center">
<div class="col-lg-8">

<div class="card shadow-lg border-0 doctor-card">

<div class="card-header bg-primary text-white">
<h4 class="mb-0">👨‍⚕️ Add New Doctor</h4>
</div>

<div class="card-body p-4">

<form action="/add-doctor" method="POST" enctype="multipart/form-data">

<!-- Basic Information -->

<h5 class="section-title">Basic Information</h5>

<div class="row">

<div class="col-md-6 mb-3">
<label>Name</label>
<input type="text" class="form-control " name="name" placeholder="Enter doctor name" required>
</div>

<div class="col-md-6 mb-3">
<label>Email Address</label>
<input type="email" class="form-control" name="email" placeholder="Enter email address" required>
</div>

<div class="col-md-6 mb-3">
<label>Password</label>
<input type="password" class="form-control" name="password" placeholder="Enter password" required>
</div>

<div class="col-md-6 mb-3">
<label>Specialization</label>

<select name="specialization" class="form-control " required>

<option value="">-- Select Specialization --</option>

<% specialization.forEach(spe=>{ %>

<option value="<%= spe._id %>">
<%= spe.name %>
</option>

<% }) %>

</select>

</div>

</div>

<!-- Professional Details -->

<h5 class="section-title mt-4">Professional Details</h5>

<div class="row">

<div class="col-md-4 mb-3">
<label>Doctor Image</label>
<input type="file" name="image" class="form-control">
</div>

<div class="col-md-4 mb-3">
<label>Experience (Years)</label>
<input type="number" class="form-control" name="experience" placeholder="Years">
</div>

<div class="col-md-4 mb-3">
<label>Consultation Fee</label>
<input type="number" class="form-control" name="consultationFee" placeholder="Fee">
</div>

</div>

<!-- Availability -->

<h5 class="section-title mt-4">Doctor Availability</h5>

<div class="availability-box">

<% 
const days = ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"];
%>

<% days.forEach(day => { %>

<div class="row align-items-center availability-row">

<div class="col-md-3">
<strong><%= day %></strong>
</div>

<div class="col-md-3">
<input 
type="time" 
name="startTime_<%= day %>" 
class="form-control">
</div>

<div class="col-md-3">
<input 
type="time" 
name="endTime_<%= day %>" 
class="form-control">
</div>

<div class="col-md-3 text-end">
<label class="off-label">
<input 
type="checkbox" 
name="off_<%= day %>"> Off
</label>
</div>

</div>

<% }) %>

</div>

<div class="mt-4 text-center">
<button type="submit" class="btn btn-success px-5 py-2">
➕ Add Doctor
</button>
</div>

</form>

</div>
</div>

</div>
</div>

</div>

<%- include('../admin/layout/footer') %>