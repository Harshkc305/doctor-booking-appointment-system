<%- include ("../admin/layout/header") %>   
<%- include("../admin/layout/sidebar")%>
<%- include("../admin/layout/navbar") %>   

<div class="container-fluid mt-4">
   <div class="card shadow mb-4">
       <div class="card-body">
           <h5 class="mb-1">welcome,<strong><%=user.name%></strong></h5>
           <p class="text-muted mb-0"><%= user.email %></p>
       </div>
    </div> 

    <div class="row">

        <div class="col-md-3 mb-4">
                <div class="card shadow border-left-primary">
                    <div class="card-body">
                        <h6 class="text-primary">Total Admin</h6>
                        <h3><%= totalAdmins %></h3>
                        <small>Admins: <%= totalAdmins %></small>
                    </div>
                </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow border-left-success">
                <div class="card-body">
                    <h6 class="text-success">Total Doctor</h6>
                    <h3><%= totalDoctor %></h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow border-left-info">
                <div class="card-body">
                    <h6 class="text-info">Specialization</h6>
                    <h3><%= totalSpecialization %></h3>
                </div>
            </div>
        </div>


    </div>

    <!-- RECENT Admin -->
            <div class="card shadow mb-4">
                <div class="card-header text-white">
                    👨‍💼 Admin
                </div>
                <div class="card-body table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentAdmin.forEach(u => { %>
                                <tr>
                                    <td><%= u.name %></td>
                                    <td><%= u.email %></td>
                                    <td><%= u.role %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
    <!-- RECENT Doctor -->
            <div class="card shadow mb-4">
                <div class="card-header text-white">
                    🩺 Doctor
                </div>
                <div class="card-body table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>specialization</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentDoctor.forEach(u => { %>
                                <tr>
                                    <td><%= u.name %></td>
                                    <td><%= u.email %></td>
                                    <td><%= u.specialization.name %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

</div>
   
<%- include('../admin/layout/footer') %>