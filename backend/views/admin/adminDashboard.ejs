<%- include ("../admin/layout/header") %>   
<%- include("../admin/layout/sidebar")%>
<%- include("../admin/layout/navbar") %>   

<div class="container-fluid mt-4">
   <div class="card shadow mb-4">
       <div class="card-body">
           <h5 class="mb-1">welcome,<strong><%=user.name%></strong></h5>
           <p class="text-muted mb-0"><%= user.email %></p>
       </div>
    </div> 

    <div class="row">

        <div class="col-md-3 mb-4">
                <div class="card shadow border-left-primary">
                    <div class="card-body">
                        <h6 class="text-primary">Total Admin</h6>
                        <h3><%= totalAdmins %></h3>
                        <small>Admins: <%= totalAdmins %></small>
                    </div>
                </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow border-left-success">
                <div class="card-body">
                    <h6 class="text-success">Total Doctor</h6>
                    <h3><%= totalDoctor %></h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow border-left-info">
                <div class="card-body">
                    <h6 class="text-info">Specialization</h6>
                    <h3><%= totalSpecialization %></h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow border-left-danger">
                <div class="card-body">
                    <h6 class="text-danger">Bookings</h6>
                    <h3><%= totalAppointment %></h3>
                    <small>
                        ✔ <%= confirmedAppointment %> |
                        ⏳ <%= pendingAppointment %> |
                        ❌ <%= cancelledAppointment %>
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow border-left-success">
                <div class="card-body">
                    <h6 class="text-success">Revenue</h6>
                    <h3>₹ <%= totalRevenue %></h3>
                </div>
            </div>
        </div>


    </div>

    <!-- RECENT Admin -->
            <div class="card shadow mb-4">
                <div class="card-header text-white">
                    👨‍💼 Admin
                </div>
                <div class="card-body table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentAdmin.forEach(u => { %>
                                <tr>
                                    <td><%= u.name %></td>
                                    <td><%= u.email %></td>
                                    <td><%= u.role %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
    <!-- RECENT Doctor -->
            <div class="card shadow mb-4">
                <div class="card-header text-white">
                    🩺 Doctor
                </div>
                <div class="card-body table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>specialization</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentDoctor.forEach(u => { %>
                                <tr>
                                    <td><%= u.name %></td>
                                    <td><%= u.email %></td>
                                    <td><%= u.specialization.name %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card shadow mb-4">
    <div class="card-header text-white bg-primary">
        🩺 Recent Bookings
    </div>
    <div class="card-body table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Patient Name</th>
                    <th>Doctor Name</th>
                    <th>Specialization</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (recentBooking && recentBooking.length > 0) { %>
                    <% recentBooking.forEach(u => { %>
                        <tr>
                            <td><%= u.patientId ? u.patientId.name : 'N/A' %></td>
                            <td><%= u.doctorId ? u.doctorId.name : 'N/A' %></td>
                            <td>
                                <%= (u.doctorId && u.doctorId.specialization) 
                                    ? u.doctorId.specialization.name 
                                    : 'General' %>
                            </td>
                            <td>
                                <span class="badge badge-info"><%= u.status %></span>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" class="text-center">No recent bookings found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

</div>
   
<%- include('../admin/layout/footer') %>