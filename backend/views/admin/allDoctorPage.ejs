<%- include ("../admin/layout/header") %>   
<%- include("../admin/layout/sidebar")%>
<%- include("../admin/layout/navbar") %>   

<link rel="stylesheet" href="/css/allDoctor.css">

<div class="container-fluid mt-4">

<!-- PAGE HEADER -->

<div class="card category-card">

<div class="card-header d-flex justify-content-between align-items-center">
<h4 class="page-title">👨‍⚕️ Doctors</h4>

<span class="count-badge">
Total Doctors: <%= data.length %>
</span>
</div>


</div>


<!-- DOCTOR TABLE -->

<div class="card doctor-card">

<div class="card-body">

<div class="table-responsive">

<table class="table doctor-table align-middle">

<thead>
<tr>
<th>#</th>
<th>Doctor</th>
<th>Email</th>
<th>Specialization</th>
<th class="text-end">Actions</th>
</tr>
</thead>

<tbody>

<% if (data.length > 0) { %>

<% data.forEach((item,index)=>{ %>

<tr>

<td class="index"><%= index+1 %></td>

<td>

<div class="doctor-info">

<img
src="<%= item.image ? item.image : '/img/undraw_profile.svg' %>"
class="doctor-avatar">

<div class="doctor-name">
<%= item.name %>
</div>

</div>

</td>

<td class="email">
<%= item.email %>
</td>

<td>

<span class="spec-badge">

<%= item.specialization ? item.specialization.name : "N/A" %>

</span>

</td>

<td class="text-end">
<div class="action-group">
    <a
    href="/single-Docter-Page/<%= item._id %>"
    class="action-btn view"
    title="View"
    >
    <i class="fas fa-eye"></i>
    </a>
    <a
    href="/edit-Doctor-Page/<%= item._id %>"
    class="action-btn edit"
    title="Edit"
    >
    <i class="fas fa-pen"></i>
    </a>



    <a
    href="/delete-Doctor/<%= item._id %>"
    onclick="return confirm('Delete this Doctor?')"
    class="delete-btn"
    title="Delete">
    
    <i class="fas fa-trash"></i>
    
    </a>
</div>

</td>

</tr>

<% }) %>

<% } else { %>

<tr>
<td colspan="5" class="empty-state">
No doctors available
</td>
</tr>

<% } %>

</tbody>

</table>

</div>

</div>

</div>

</div>

<%- include('../admin/layout/footer') %>