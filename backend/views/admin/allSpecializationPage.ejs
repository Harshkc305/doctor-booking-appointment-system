<%- include ("../admin/layout/header") %>   
<%- include("../admin/layout/sidebar")%>
<%- include("../admin/layout/navbar") %>   



<div class="container-fluid mt-4">

<div class="card category-card">

<div class="card-header d-flex justify-content-between align-items-center">

<h5 class="mb-0">🩺 All Specializations</h5>

<span class="count-badge">
<%= data.length %>
</span>

</div>

<div class="card-body table-responsive">

<% if (data.length > 0) { %>

<table class="table modern-table align-middle">

<thead>
<tr>
<th>#</th>
<th>Specialization</th>
<th class="text-center">Action</th>
</tr>
</thead>

<tbody>

<% data.forEach((item, index) => { %>

<tr>

<td><%= index + 1 %></td>

<td>
<span class="spec-badge">
<%= item.name %>
</span>
</td>

<td class="text-center">

<a
href="/deleteSpecialization/<%= item._id %>"
onclick="return confirm('Are you sure you want to delete this specialization?')"
class="delete-btn"
title="Delete"
>

<i class="fas fa-trash"></i>

</a>

</td>

</tr>

<% }) %>

</tbody>

</table>

<% } else { %>

<div class="empty-state">

<i class="fas fa-folder-open"></i>

<h5>No Specializations Available</h5>

<p>Add a new specialization to get started.</p>

</div>

<% } %>

</div>

</div>

</div>

<%- include('../admin/layout/footer') %>