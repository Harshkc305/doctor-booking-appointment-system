<%- include ("./layout/header") %>   
<%- include("./layout/sidebar")%>
<%- include("./layout/navbar") %>   

<link rel="stylesheet" href="/css/adminLogin.css">

<div class="container-fluid login-page">

<div class="row justify-content-center w-100">
<div class="col-lg-4 col-md-6">

<div class="card login-card">

<div class="card-header text-center">
<h4>🔐 Admin Login</h4>
<p>Access your dashboard</p>
</div>

<div class="card-body">

<form action="/admin-login" method="POST">

<div class="form-group">
<label>Email Address</label>
<input type="email" class="form-control modern-input" name="email" placeholder="Enter email" required>
</div>

<div class="form-group">
<label>Password</label>
<input type="password" class="form-control modern-input" name="password" placeholder="Enter password" required>
</div>

<button type="submit" class="btn submit-btn">
Login
</button>

<div class="text-center mt-3">
<span class="text-muted">Forgot Password?</span>
<a href="/forget-password-page" class="forget-link">
Click Here
</a>
</div>

</form>

</div>
</div>

</div>
</div>

</div>

<%- include('./layout/footer') %>