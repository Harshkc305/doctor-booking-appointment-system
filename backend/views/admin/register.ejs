<%- include ("../admin/layout/header") %>   
<%- include("../admin/layout/sidebar")%>
<%- include("../admin/layout/navbar") %>   

<link rel="stylesheet" href="/css/adminRegister.css">

<div class="container-fluid register-page">

<div class="row">
<div class="col-lg-5 col-md-7">

<div class="card register-card">

<div class="card-header text-center">
<h4>🛡 Admin Registration</h4>

</div>

<div class="card-body">

<form action="/admin-register" enctype="multipart/form-data" method="POST">

<div class="form-group">
<label>Name</label>
<input type="text" class="form-control modern-input" name="name" placeholder="Enter full name" required>
</div>

<div class="form-group">
<label>Email Address</label>
<input type="email" class="form-control modern-input" name="email" placeholder="Enter email address" required>
</div>

<div class="form-group">
<label>Password</label>
<input type="password" class="form-control modern-input" name="password" placeholder="Enter password" required>
</div>

<div class="form-group">
<label>Profile Image</label>
<input type="file" class="form-control modern-input" name="image">
</div>

<button type="submit" class="btn submit-btn">
Register Admin
</button>

</form>

</div>
</div>

</div>
</div>

</div>

<%- include('../admin/layout/footer') %>