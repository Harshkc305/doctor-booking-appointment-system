<%- include ("./layout/header") %>   
<%- include("./layout/sidebar")%>
<%- include("./layout/navbar") %>        

<div class="container-fluid">
    
<div class="login-bg d-flex justify-content-center align-items-center">

<div class="card login-card shadow-lg">

<div class="card-body login-card-body">

<h3 class="login-text text-center mb-4">
🔐 Reset Password
</h3>

<form method="POST" action="/reset-password/<%= userId %>/<%= token %>">

<div class="mb-3">
<label class="form-label">New Password</label>
<input 
type="password" 
class="form-control" 
name="password" 
placeholder="Enter New Password"
required>
</div>

<div class="mb-3">
<label class="form-label">Confirm Password</label>
<input 
type="password" 
class="form-control" 
name="confirm_password" 
placeholder="Confirm Password"
required>
</div>

<button type="submit" class="btn btn-primary rounded-pill w-100 mt-2">
Reset Password
</button>

</form>

</div>

</div>

</div>

</div>

<%- include('./layout/footer') %>