<%- include("../admin/layout/navbar") %>   

<div class="container-fluid mt-4">
   <div class="Category-page">

                <div class="card cardcategory cc">
                    <div class="card-header bg-secondary text-white">
                        <h3 class="mb-0" style="font-family: 'Comfortaa';">➕ Add Specialization</h3>
                    </div>
                    <div class="card-body">
                        <form action="/createspecialization" method="post">
                            
                            <!-- Name -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Specialization Name</label>
                                <input type="text" name="name" placeholder="Enter Specialization name" class="form-control rounded-pill shadow-sm" required />
                            </div>
                            
                           

                            <button type="submit" class="btn gradient-btn rounded-pill px-4 shadow-sm">
                                Submit Specialization
                            </button>

                            
                        </form>
                    </div>
                </div>
            </div>
</div>
   
