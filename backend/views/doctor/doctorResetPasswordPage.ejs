<%- include ("./doctor/layout/header") %>   
<%- include("./doctor/layout/sidebar")%>
<%- include("./doctor/layout/navbar") %>        

<div class="container-fluid ">
    <div class="login-bg d-flex justify-content-center align-items-center">

        <div class="card login-card">
            <div class="card-body login-card-body" >
                
                
                <h3 class="login-text text-center mb-4">Forget password</h3>

                <form method="POST" action="/doctor-reset-password/<%= doctorId %>/<%= token %>">
                    <div class="mb-3">
                        <input type="password" class="form-control" name="password" placeholder="New Password" required>
                        <input type="password" class="form-control" name="confirm_password" placeholder="Confirm Password" required>

                    

                    <button type="submit" class="btn btn-primary rounded-pill w-100">Reset</button>
                </form>

            </div>
        </div>
    </div>
                    


     
</div>
                

<%- include('./doctor/layout/footer') %>