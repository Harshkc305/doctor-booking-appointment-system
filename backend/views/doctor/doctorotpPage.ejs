<%- include ("../doctor/layout/header") %>   
<%- include("../doctor/layout/sidebar")%>
<%- include("../doctor/layout/navbar") %>        

<div class="container-fluid login-page">

<div class="row justify-content-center w-100">

<div class="col-lg-4 col-md-6">

<div class="card login-card">

<div class="card-header text-center">
<h4>📩 OTP Verification</h4>
<p>Enter the OTP sent to your email</p>
</div>

<div class="card-body">

<form action="/doctorVerifyEmail" method="POST">

<div class="form-group">
<label>Email Address</label>
<input type="email" class="form-control modern-input" name="email" placeholder="Enter email" required>
</div>

<div class="form-group">
<label>OTP</label>
<input type="text" class="form-control modern-input" name="otp" placeholder="Enter OTP" required>
</div>

<button type="submit" class="submit-btn">
Verify OTP
</button>

</form>

</div>

</div>

</div>

</div>

</div>

<%- include('../doctor/layout/footer') %>