<%- include ("../doctor/layout/header") %>   
<%- include("../doctor/layout/sidebar")%>
<%- include("../doctor/layout/navbar") %>   

<div class="container-fluid px-4 py-4">

<div class="row g-4 mx-2">

<!-- PROFILE CARD -->
<div class="col-lg-4">

<div class="card border-0 shadow-lg text-center p-4 h-100">

<div class="position-relative">

<img src="<%= doctor.image %>" 
class="rounded-circle shadow"
style="width:150px;height:150px;object-fit:cover;border:5px solid #4e73df">

</div>

<h4 class="mt-3 fw-bold text-dark">
<i class="fas fa-user-md text-primary me-1"></i>
<%= doctor.name %>
</h4>

<p class="text-muted mb-2">
<i class="fas fa-envelope me-1"></i>
<%= doctor.email %>
</p>

<span class="badge bg-primary text-white px-4 py-2 fs-6">
<%= doctor.specialization.name %>
</span>

<hr>

<div class="row text-center mt-3">

<div class="col-6 border-end">
<h6 class="text-muted">Experience</h6>
<h5 class="fw-bold text-primary">
<i class="fas fa-briefcase-medical me-1"></i>
<%= doctor.experience %> yrs
</h5>
</div>

<div class="col-6">
<h6 class="text-muted">Consultation</h6>
<h5 class="fw-bold text-success">
<i class="fas fa-rupee-sign me-1"></i>
₹<%= doctor.consultationFee %>
</h5>
</div>

</div>

<a href="/doctor-update-profile-page" 
class="btn btn-primary mt-4 w-100 rounded-pill shadow-sm">

<i class="fas fa-edit me-1"></i>
Edit Profile

</a>

</div>

</div>


<!-- SLOTS CARD -->
<div class="col-lg-8">

<div class="card shadow-lg border-0 h-100">

<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center px-4">

<h5 class="mb-0">
<i class="fas fa-calendar-check me-2"></i>
Available Slots
</h5>

</div>

<div class="card-body p-4">

<table class="table table-hover align-middle text-center">

<thead class="table-light">

<tr>
<th>Day</th>
<th>Start Time</th>
<th>End Time</th>
</tr>

</thead>

<tbody>

<% if(doctor.availableSclots.length > 0){ %>

<% doctor.availableSclots.forEach(slot => { %>

<tr>

<td class="fw-semibold text-dark">
<i class="fas fa-calendar-day text-primary me-1"></i>
<%= slot.day %>
</td>

<td>
<span class="badge  px-3 py-2">
<i class="fas fa-clock me-1"></i>
<%= slot.startTime %>
</span>
</td>

<td>
<span class="badge  px-3 py-2">
<i class="fas fa-clock me-1"></i>
<%= slot.endTime %>
</span>
</td>

</tr>

<% }) %>

<% } else { %>

<tr>
<td colspan="3" class="text-muted">
No slots available
</td>
</tr>

<% } %>

</tbody>

</table>

</div>

</div>

</div>

</div>

</div>

<%- include('../doctor/layout/footer') %>