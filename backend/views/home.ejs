<%- include("./layout/header") %>

<div id="content-wrapper" class="d-flex flex-column">
  <div id="content">
    <div
      class="container-fluid home-pg d-flex justify-content-center align-items-center">
      <div class="row w-100 justify-content-center">
        <!-- Admin Login Card -->
        <div class="col-md-3 mb-4">
          <div class="card shadow-lg border-0 text-center p-4 h-100">
            <h2 class="fw-bold mb-3 text-primary">👨‍💼 Admin Panel</h2>

            <p class="text-muted mb-4">
              Admin can manage doctors, view appointments, track earnings and
              control the whole system.
            </p>

            <a
              href="/admin-login-page"
              class="btn btn-primary rounded-pill px-4 shadow"
            >
              🔐 Login as Admin
            </a>
          </div>
        </div>

        <!-- Doctor Login Card -->
        <div class="col-md-3 mb-4">
          <div class="card shadow-lg border-0 text-center p-4 h-100">
            <h2 class="fw-bold mb-3 text-success">🩺 Doctor Panel</h2>

            <p class="text-muted mb-4">
              Doctors can manage appointments, accept patients, cancel bookings
              and update their profile.
            </p>

            <a
              href="/doctor-login-page"
              class="btn btn-success rounded-pill px-4 shadow"
            >
              👨‍⚕️ Login as Doctor
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
